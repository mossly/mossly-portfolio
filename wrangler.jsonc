{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mossly-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "mossly-images" }],
  "vars": {
    "IMAGES_BASE": "https://images.mossly.org",
    "ACCESS_AUD": "8b508963ea0cbce93701874c9bc880c64764a953ae6a4f25fe6746d365dae6d6",
    "ACCESS_TEAM_DOMAIN": "mossly.cloudflareaccess.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mossly-content",
      "database_id": "11f56e26-dc8c-47bf-ab61-fde1e1367c61",
      "migrations_dir": "migrations"
    }
  ]
}
